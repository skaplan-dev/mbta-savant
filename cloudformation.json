{
  "Description": "MBTA Savant static site: S3 + CloudFront + Route53 for savant.labs.transitmatters.org. COST ESTIMATE (MBTA Savant hosting): S3 storage for roughly 1 GB of ingested segments per year is about $0.023/GB-month, i.e. under $0.30/yr growing linearly (about $0.50 total in year 2-3); the served site plus data/*.json is a few MB. CloudFront at hobby traffic (PriceClass_100, well under the 1 TB/month and 10M request free tier) is $0. Route53 record adds no cost beyond the existing labs.transitmatters.org zone; the ACM wildcard certificate is free. GitHub Actions minutes are free for public repos. Expected total: well under $1/month. Segments are denied to the public (bucket policy NotResource plus a CloudFront Function) so they cost no egress.",
  "Metadata": {
    "CostEstimate": "COST ESTIMATE (MBTA Savant hosting): S3 storage for roughly 1 GB of ingested segments per year is about $0.023/GB-month, i.e. under $0.30/yr growing linearly (about $0.50 total in year 2-3); the served site plus data/*.json is a few MB. CloudFront at hobby traffic (PriceClass_100, well under the 1 TB/month and 10M request free tier) is $0. Route53 record adds no cost beyond the existing labs.transitmatters.org zone; the ACM wildcard certificate is free. GitHub Actions minutes are free for public repos. Expected total: well under $1/month. Segments are denied to the public (bucket policy NotResource plus a CloudFront Function) so they cost no egress."
  },
  "Parameters": {
    "TMFrontendHostname": {
      "Type": "String",
      "Default": "savant.labs.transitmatters.org",
      "AllowedValues": [
        "savant.labs.transitmatters.org"
      ],
      "Description": "The frontend hostname for MBTA Savant"
    },
    "TMFrontendZone": {
      "Type": "String",
      "Default": "labs.transitmatters.org",
      "AllowedPattern": "labs\\.transitmatters\\.org$",
      "Description": "The frontend's DNS zone file name."
    },
    "TMFrontendCertArn": {
      "Type": "String",
      "Description": "The ACM ARN of the wildcard certificate covering savant.labs.transitmatters.org (us-east-1)."
    }
  },
  "Resources": {
    "FrontendBucket": {
      "Type": "AWS::S3::Bucket",
      "Properties": {
        "PublicAccessBlockConfiguration": {
          "BlockPublicPolicy": false,
          "RestrictPublicBuckets": false
        },
        "BucketName": {
          "Ref": "TMFrontendHostname"
        },
        "WebsiteConfiguration": {
          "IndexDocument": "index.html",
          "ErrorDocument": "index.html"
        },
        "Tags": [
          {
            "Key": "service",
            "Value": "mbta-savant"
          }
        ]
      }
    },
    "FrontendBucketPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "FrontendBucket"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "PublicReadForGetBucketObjects",
              "Effect": "Allow",
              "Principal": "*",
              "Action": "s3:GetObject",
              "NotResource": {
                "Fn::Join": [
                  "",
                  [
                    {
                      "Fn::GetAtt": [
                        "FrontendBucket",
                        "Arn"
                      ]
                    },
                    "/segments/*"
                  ]
                ]
              }
            }
          ]
        }
      }
    },
    "BlockSegmentsFunction": {
      "Type": "AWS::CloudFront::Function",
      "Properties": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-block-segments"
        },
        "AutoPublish": true,
        "FunctionConfig": {
          "Comment": "Return 404 for /segments/* so raw pipeline segments are not served publicly",
          "Runtime": "cloudfront-js-2.0"
        },
        "FunctionCode": "function handler(event) {\n  var req = event.request;\n  if (req.uri.indexOf('/segments/') === 0) {\n    return { statusCode: 404, statusDescription: 'Not Found' };\n  }\n  return req;\n}\n"
      }
    },
    "CloudFrontDistribution": {
      "Type": "AWS::CloudFront::Distribution",
      "Properties": {
        "DistributionConfig": {
          "Aliases": [
            {
              "Ref": "TMFrontendHostname"
            }
          ],
          "Comment": {
            "Fn::Sub": "CloudFront distribution for ${TMFrontendHostname}"
          },
          "DefaultCacheBehavior": {
            "TargetOriginId": "S3Origin",
            "ViewerProtocolPolicy": "redirect-to-https",
            "AllowedMethods": [
              "GET",
              "HEAD"
            ],
            "CachedMethods": [
              "GET",
              "HEAD"
            ],
            "ForwardedValues": {
              "QueryString": false,
              "Cookies": {
                "Forward": "none"
              }
            },
            "Compress": true,
            "DefaultTTL": 86400,
            "MaxTTL": 31536000,
            "FunctionAssociations": [
              {
                "EventType": "viewer-request",
                "FunctionARN": {
                  "Fn::GetAtt": [
                    "BlockSegmentsFunction",
                    "FunctionMetadata.FunctionARN"
                  ]
                }
              }
            ]
          },
          "DefaultRootObject": "index.html",
          "Enabled": true,
          "HttpVersion": "http2",
          "Origins": [
            {
              "Id": "S3Origin",
              "DomainName": {
                "Fn::Sub": "${TMFrontendHostname}.s3-website-us-east-1.amazonaws.com"
              },
              "CustomOriginConfig": {
                "HTTPPort": 80,
                "HTTPSPort": 443,
                "OriginProtocolPolicy": "http-only"
              }
            }
          ],
          "CustomErrorResponses": [
            {
              "ErrorCode": 403,
              "ResponseCode": 200,
              "ResponsePagePath": "/index.html"
            },
            {
              "ErrorCode": 404,
              "ResponseCode": 200,
              "ResponsePagePath": "/index.html"
            }
          ],
          "PriceClass": "PriceClass_100",
          "ViewerCertificate": {
            "AcmCertificateArn": {
              "Ref": "TMFrontendCertArn"
            },
            "SslSupportMethod": "sni-only",
            "MinimumProtocolVersion": "TLSv1.2_2021"
          }
        },
        "Tags": [
          {
            "Key": "service",
            "Value": "mbta-savant"
          },
          {
            "Key": "env",
            "Value": "prod"
          }
        ]
      }
    },
    "DNSRecord": {
      "Type": "AWS::Route53::RecordSet",
      "Properties": {
        "HostedZoneName": {
          "Fn::Sub": "${TMFrontendZone}."
        },
        "Name": {
          "Ref": "TMFrontendHostname"
        },
        "Type": "A",
        "AliasTarget": {
          "DNSName": {
            "Fn::GetAtt": [
              "CloudFrontDistribution",
              "DomainName"
            ]
          },
          "EvaluateTargetHealth": false,
          "HostedZoneId": "Z2FDTNDATAQYW2"
        }
      }
    }
  },
  "Outputs": {
    "WebsiteURL": {
      "Value": {
        "Fn::Sub": "https://${TMFrontendHostname}"
      },
      "Description": "URL for website hosted on CloudFront"
    },
    "CloudFrontDistributionId": {
      "Value": {
        "Ref": "CloudFrontDistribution"
      },
      "Description": "CloudFront Distribution ID"
    },
    "S3BucketName": {
      "Value": {
        "Ref": "FrontendBucket"
      },
      "Description": "Name of the S3 bucket",
      "Export": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-S3BucketName"
        }
      }
    }
  }
}
